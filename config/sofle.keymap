#include "common_keymap.dtsi"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&lt {
    flavor = "balanced";
    quick-tap-ms = <175>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <220>;
};

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        toggle_gaming {
            bindings = <&to 7>;
            key-positions = <37 48>;
            layers = <0 2 4 1>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        bspc {
            bindings = <&kp BSPC>;
            key-positions = <19 20>;
            layers = <0 2 4 1>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <20 21>;
            layers = <0 2 4 1>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <26 27>;
            layers = <0 2 4 1>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <38 40>;
            layers = <0 2 4 1>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        copy {
            bindings = <&kp LC(INS)>;
            key-positions = <38 39>;
            layers = <0 2 4 1>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        paste {
            bindings = <&kp LS(INS)>;
            key-positions = <39 40>;
            layers = <0 2 4 1>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        lpar_lt {
            bindings = <&lpar_lt_moprh>;
            key-positions = <31 32>;
            layers = <0 1 4>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        rpar_gt {
            bindings = <&rpar_gt_morph>;
            key-positions = <32 33>;
            layers = <0 1 4>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        lt {
            bindings = <&kp LT>;
            key-positions = <31 32>;
            layers = <2>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        gt {
            bindings = <&kp GT>;
            key-positions = <32 33>;
            layers = <2>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        lbkt {
            bindings = <&kp LBKT>;
            key-positions = <45 46>;
            layers = <0 1 4>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <46 47>;
            layers = <0 1 4>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        lbrc {
            bindings = <&kp LBRC>;
            key-positions = <45 46>;
            layers = <2>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        rbrc {
            bindings = <&kp RBRC>;
            key-positions = <46 47>;
            layers = <2>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <14 15>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
            layers = <0 2 4 1>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <14 25>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <15 26>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4>;
        };

        dllr {
            bindings = <&kp DOLLAR>;
            key-positions = <16 27>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        prcnt {
            bindings = <&kp PERCENT>;
            key-positions = <17 28>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <26 37>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4>;
        };

        blsh {
            bindings = <&kp BACKSLASH>;
            key-positions = <27 38>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <28 39>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <29 40>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <18 31>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <19 32>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <20 33>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4>;
        };

        amps {
            bindings = <&kp AMPS>;
            key-positions = <21 34>;
            layers = <0 1 2 4>;
        };

        under {
            bindings = <&kp UNDER>;
            key-positions = <30 45>;
            layers = <0 1 2 4>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <31 46>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        fslh {
            bindings = <&kp FSLH>;
            key-positions = <47 32>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <33 48>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        toggle_default {
            bindings = <&to 0>;
            key-positions = <37 48>;
            layers = <0 1 2 4>;
        };

        slh {
            bindings = <&kp FSLH>;
            key-positions = <27 40>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 4 1>;
        };

        toggle_colemak {
            bindings = <&to 1>;
            key-positions = <38 47>;
            layers = <0 1 2 4>;
        };
    };

    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
            hold-trigger-on-release;
            require-prior-idle-ms = <100>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
        };

        hsl: homerow_shift_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
            hold-trigger-on-release;
        };

        hsr: homerow_shift_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
        };

        hll: homerow_layer_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LAYER_LEFT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59 39 40 41>;
        };

        hlr: homerow_layer_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LAYER_RIGHT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54 45 46 47>;
        };

        lpar_lt_moprh: lpar_lt_moprh {
            compatible = "zmk,behavior-mod-morph";
            label = "LPAR_LT_MOPRH";
            bindings = <&kp LPAR>, <&kp LT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rpar_gt_morph: rpar_gt_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "RPAR_GT_MORPH";
            bindings = <&kp RPAR>, <&kp GT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hm_combo_lpar_lt: hm_combo_lpar_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_COMBO_LPAR_LT";
            bindings = <&kp>, <&lpar_lt_moprh>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54 2 3 4 55 56 57 58 59>;
        };

        hm_combo_rpar_gt: hm_combo_rpar_gt {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_COMBO_RPAR_GT";
            bindings = <&kp>, <&rpar_gt_morph>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54 2 3 4 55 56 57 58 59>;
        };

        masked_home: masked_home {
            compatible = "zmk,behavior-mod-morph";
            label = "MASKED_HOME";
            bindings = <&kp HOME>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        masked_end: masked_end {
            compatible = "zmk,behavior-mod-morph";
            label = "MASKED_END";
            bindings = <&kp END>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        mt_home: mt_home {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_HOME";
            bindings = <&masked_home>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
            quick-tap-ms = <220>;
        };

        mt_end: mt_end {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_END";
            bindings = <&masked_end>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
            quick-tap-ms = <220>;
        };

        comma_morph: comma_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_MORPH";
            bindings = <&kp COMMA>, <&comma_inner_morph>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_inner_morph: comma_inner_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_INNER_MORPH";
            bindings = <&kp SEMICOLON>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_LCTL)>;
        };

        dot_morph: dot_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_MORPH";
            bindings = <&kp DOT>, <&dot_inner_morph>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_inner_morph: dot_inner_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_INNER_MORPH";
            bindings = <&kp COLON>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_LCTL)>;
        };

        qexcl: qexcl {
            compatible = "zmk,behavior-mod-morph";
            label = "QEXCL";
            bindings = <&kp QUESTION>, <&kp EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        magic_shift: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_SHIFT";
            bindings = <&kp>, <&none>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
        };

        magic_shift_tap: magic_shift_tap {
            compatible = "zmk,behavior-mod-morph";
            label = "MAGIC_SHIFT_TAP";
            bindings = <&none>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        next_workspace: next_workspace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LGUI>;

            label = "NEXT_WORKSPACE";
        };

        prev_workspace: prev_workspace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LGUI>;

            label = "PREV_WORKSPACE";
        };

        next_tab: next_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LALT>;

            label = "NEXT_TAB";
        };

        prev_tab: prev_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LALT>;

            label = "PREV_TAB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE  &kp N1       &kp N2       &kp N3        &kp N4        &kp N5                                &kp N6      &kp N7        &kp N8        &kp N9       &kp N0         &none
&kp ESC    &kp Q        &kp W        &kp E         &kp R         &kp T                                 &kp Y       &kp U         &kp I         &kp O        &kp P          &kp BSPC
&kp TAB    &hml LGUI A  &hml LALT S  &hsl LSHFT D  &hml LCTRL F  &kp G                                 &kp H       &hmr RCTRL J  &hsr RSHFT K  &hmr LALT L  &hmr RGUI SQT  &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C         &kp V         &kp B     &kp C_MUTE     &none        &kp N       &kp M         &comma_morph  &dot_morph   &qexcl         &kp ENTER
                        &kp LSHFT    &kp LCTRL     &kp LGUI      &kp LALT  &lt 3 SPACE    &lt 4 ENTER  &kp RSHIFT  &mo 2         &kp RALT      &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        colemak_layer {
            display-name = "colemak";
            bindings = <
&kp GRAVE  &kp N1       &kp N2       &kp N3        &kp N4        &kp N5                                  &kp N6     &kp N7        &kp N8        &kp N9       &kp N0       &none
&kp ESC    &kp Q        &kp W        &kp F         &kp P         &kp T                                   &kp J      &kp L         &kp U         &kp Y        &kp SQT      &kp BSPC
&kp TAB    &hml LGUI A  &hml LALT R  &hsl LSHFT S  &hml LCTRL T  &kp G                                   &kp M      &hmr RCTRL N  &hsr RSHFT E  &hmr LALT I  &hmr RGUI O  &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C         &kp D         &kp V       &kp C_MUTE     &none        &kp K      &kp H         &comma_morph  &dot_morph   &qexcl       &kp ENTER
                        &kp LGUI     &kp LALT      &mo 6         &kp LSHIFT  &lt 3 SPACE    &lt 4 ENTER  &kp LCTRL  &mo 2         &kp RALT      &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            bindings = <
&trans  &trans    &trans           &trans           &trans           &trans                          &trans           &trans             &trans           &trans           &trans     &trans
&trans  &trans    &prev_tab        &next_tab        &next_tab        &trans                          &kp PAGE_UP      &mt LC(BSPC) BSPC  &trans           &mt LC(DEL) DEL  &trans     &trans
&trans  &sk LGUI  &sk LALT         &sk LSHFT        &sk LCTRL        &trans                          &mt_home 0 LEFT  &mt LC(END) DOWN   &mt LC(HOME) UP  &mt_end 0 RIGHT  &kp ENTER  &trans
&trans  &trans    &prev_workspace  &next_workspace  &next_workspace  &trans        &trans    &trans  &kp PAGE_DOWN    &kp TAB            &kp INS          &kp CLCK         &trans     &trans
                  &trans           &trans           &trans           &kp K_CANCEL  &trans    &trans  &trans           &trans             &trans           &trans
            >;

            label = "nav";
        };

        fn_layer {
            bindings = <
&trans  &trans         &trans        &trans         &trans         &trans                    &trans  &trans             &trans                  &trans  &trans  &trans
&trans  &kp F12        &kp F7        &kp F8         &kp F9         &trans                    &trans  &kp C_PREVIOUS     &kp C_NEXT              &trans  &trans  &trans
&trans  &hml LGUI F11  &hml LALT F4  &hsl LSHFT F5  &hml LCTRL F6  &trans                    &trans  &kp C_VOLUME_DOWN  &hsr RSHFT C_VOLUME_UP  &trans  &trans  &trans
&trans  &kp F10        &kp F1        &kp F2         &kp F3         &trans  &trans    &trans  &trans  &kp C_MUTE         &kp C_PP                &trans  &trans  &trans
                       &trans        &trans         &trans         &trans  &trans    &trans  &trans  &trans             &trans                  &trans
            >;

            label = "fn";
        };

        num_layer {
            bindings = <
&trans  &trans        &trans        &trans         &trans               &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &kp N7        &kp N8         &kp N9               &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &hml LGUI N0  &hml LALT N4  &hsl LSHFT N5  &hml LCTRL NUMBER_6  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &kp N1        &kp NUMBER_2   &kp N3               &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &trans        &trans         &trans               &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            label = "num";
        };

        sys_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "sys";
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                          &trans           &trans           &trans           &trans           &trans             &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &ext_power EP_TOG  &trans
&trans  &bt BT_CLR    &trans        &trans        &trans        &trans                          &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &bootloader        &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans           &trans           &trans           &trans           &sys_reset         &trans
                      &trans        &trans        &trans        &trans        &trans    &trans  &trans           &trans           &trans           &trans
            >;

            label = "sys";
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans                             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &msc SCRL_LEFT  &trans          &msc SCRL_RIGHT  &msc SCRL_UP                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP     &mmv MOVE_RIGHT                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp MB1        &mkp MCLK       &mkp MB2         &msc SCRL_DOWN   &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans          &trans          &trans           &trans           &trans    &trans  &trans  &trans  &trans  &trans
            >;

            label = "mouse";
        };

        game_layer {
            display-name = "game";
            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                   &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &to 0
&kp ESC    &kp Q   &kp W     &kp E     &kp R      &kp T                                    &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                                    &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B           &kp C_MUTE    &none      &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp ENTER
                   &kp LGUI  &kp LALT  &kp LCTRL  &kp LEFT_SHIFT  &kp SPACE     &kp ENTER  &kp RSHFT  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;

            label = "game";
        };
    };
};
